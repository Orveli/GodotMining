{
  "auto_exit": true,
  "cpu_ca": true,
  "_doc": "M2: bottien rakennus skriptista (bot_manager.build_bot). Todistaa materiaalipohjaisen replikaation: inventaarion IRON_ORE vahenee ja lauma kasvaa, JA nouseva resepti (ceil(10 * 1.35^n): 10, 14, 19, ...) estaa rakentamisen kun rautaa ei riita. Ajetaan headlessina (gpu_ready=false) kuten mvp_core_loop -- ei tarvitse GPU:ta eika CA:ta, vain bot_managerin build-API:n.",
  "steps": [
    { "cmd": "assert_fleet", "min": 2, "max": 2, "label": "aloituslauma = 2 bottia (1 miner + 1 hauler)" },

    { "cmd": "set_inventory", "mat": 12, "px": 25 },
    { "cmd": "assert_bot_cost", "min": 10, "max": 10, "label": "ensimmaisen botin resepti = 10 rautaa" },

    { "cmd": "build_bot", "role": 0, "count": 1 },
    { "cmd": "assert_fleet", "min": 3, "max": 3, "label": "eka replikaatio kasvatti lauman 3:een" },
    { "cmd": "assert_inventory", "mat": 12, "min": 15, "max": 15, "label": "rauta vaheni 10 (25-10=15)" },

    { "cmd": "assert_bot_cost", "min": 14, "max": 14, "label": "toisen botin resepti nousi 14:aan" },
    { "cmd": "build_bot", "role": 1, "count": 1 },
    { "cmd": "assert_fleet", "min": 4, "max": 4, "label": "toinen replikaatio kasvatti lauman 4:aan" },
    { "cmd": "assert_inventory", "mat": 12, "min": 1, "max": 1, "label": "rauta vaheni 14 (15-14=1)" },

    { "cmd": "assert_bot_cost", "min": 19, "max": 19, "label": "kolmannen botin resepti nousi 19:aan" },
    { "cmd": "build_bot", "role": 0, "count": 1 },
    { "cmd": "assert_fleet", "min": 4, "max": 4, "label": "nouseva resepti (19) estaa rakentamisen kun rautaa vain 1" },
    { "cmd": "assert_inventory", "mat": 12, "min": 1, "max": 1, "label": "epaonnistunut rakennus ei kuluttanut rautaa" }
  ]
}
