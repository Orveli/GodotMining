{
  "auto_exit": true,
  "cpu_ca": true,
  "_doc": "M2: bottien rakennus skriptista (bot_manager.build_bot). Todistaa materiaalipohjaisen replikaation: inventaarion IRON_ORE vahenee ja lauma kasvaa, JA kiintea resepti (aina 100 rautaa / botti) estaa rakentamisen kun rautaa ei riita. Ajetaan headlessina (gpu_ready=false) kuten mvp_core_loop -- ei tarvitse GPU:ta eika CA:ta, vain bot_managerin build-API:n.",
  "steps": [
    { "cmd": "assert_fleet", "min": 2, "max": 2, "label": "aloituslauma = 2 bottia (1 miner + 1 hauler)" },

    { "cmd": "set_inventory", "mat": 12, "px": 250 },
    { "cmd": "assert_bot_cost", "min": 100, "max": 100, "label": "botin resepti = kiintea 100 rautaa" },

    { "cmd": "build_bot", "role": 0, "count": 1 },
    { "cmd": "assert_fleet", "min": 3, "max": 3, "label": "eka replikaatio kasvatti lauman 3:een" },
    { "cmd": "assert_inventory", "mat": 12, "min": 150, "max": 150, "label": "rauta vaheni 100 (250-100=150)" },

    { "cmd": "assert_bot_cost", "min": 100, "max": 100, "label": "toisenkin botin resepti on yha kiintea 100" },
    { "cmd": "build_bot", "role": 1, "count": 1 },
    { "cmd": "assert_fleet", "min": 4, "max": 4, "label": "toinen replikaatio kasvatti lauman 4:aan" },
    { "cmd": "assert_inventory", "mat": 12, "min": 50, "max": 50, "label": "rauta vaheni 100 (150-100=50)" },

    { "cmd": "assert_bot_cost", "min": 100, "max": 100, "label": "kolmannenkin botin resepti on yha kiintea 100" },
    { "cmd": "build_bot", "role": 0, "count": 1 },
    { "cmd": "assert_fleet", "min": 4, "max": 4, "label": "kiintea resepti (100) estaa rakentamisen kun rautaa vain 50" },
    { "cmd": "assert_inventory", "mat": 12, "min": 50, "max": 50, "label": "epaonnistunut rakennus ei kuluttanut rautaa" }
  ]
}
